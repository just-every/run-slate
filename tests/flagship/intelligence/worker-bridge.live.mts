import {env} from 'cloudflare:test';import {test,expect} from 'vitest';import {fixture} from './fixture';import {sessionFor} from '../../e2e/setup/fixtures';import {createApi} from '../../../src/core/app/hono';import {consumeIntelligenceJob} from '../../../src/core/features/runs/worker';import type {AppBindings} from '../../../src/core/app/types';
declare const __SLATE_PROOF_URL__:string;declare const __SLATE_LIVE_URL__:string;declare const __SLATE_LIVE_TOKEN__:string;
test('Actual Worker HTTP → authenticated local Codex bridge → durable cited answer and revoked disclosure',async()=>{
 const f=await fixture(),api=createApi(),cookie=await sessionFor(f.owner),bindings={...env,LOCAL_DEVELOPMENT:'true',AI_ENABLED:'true',AI_PROVIDER:'local-codex',AI_MODEL:'gpt-6-astra',AI_LOCAL_URL:__SLATE_LIVE_URL__,AI_LOCAL_TOKEN:__SLATE_LIVE_TOKEN__} as AppBindings;
 const post=(path:string,value:unknown)=>api.request(`http://localhost:8787${path}`,{method:'POST',headers:{cookie,origin:'http://localhost:8787','content-type':'application/json'},body:JSON.stringify(value)},bindings);
 const allowance=await post('/api/ai/local-allowance',{operationKey:'case:001',monthlyTokenAllowance:1000000,perRunTokenAllowance:200000,acknowledgeProviderHasNoHardTokenCap:true});expect(allowance.status,await allowance.clone().text()).toBe(200);
 const started=await post('/api/ai/ask',{...f.ask,operationKey:'case:002',audience:[f.owner,f.reader],maxOutputTokens:1000});expect(started.status,await started.clone().text()).toBe(200);const created=await started.json() as {value:{id:string}};
 await consumeIntelligenceJob(bindings,{kind:'intelligence.run',runId:created.value.id,workspaceId:f.workspaceId});
 const read=await api.request(`http://localhost:8787/api/runs/${created.value.id}`,{headers:{cookie}},bindings);expect(read.status).toBe(200);const view=await read.json() as {status:string;cost:number;costUnit:string;monetaryCost:number|null;output:{providerReceipt:string;answer:{statements:{text:string;evidenceIds:string[]}[]}}};expect(view.status).toBe('completed');expect(view.output.providerReceipt).toMatch(/^codex:/);expect(view.costUnit).toBe('tokens');expect(view.monetaryCost).toBeNull();expect(view.cost).toBeGreaterThan(0);expect(view.output.answer.statements.some(s=>s.evidenceIds.includes('E1'))).toBe(true);expect(JSON.stringify(view.output.answer).toLowerCase()).toContain('handoff');
 const evidence=await post('/api/ai/evidence',{refs:f.refs});expect(evidence.status).toBe(200);expect(await evidence.text()).toContain('handoff');
 const proof=await fetch(__SLATE_PROOF_URL__,{method:'POST',headers:{authorization:`Bearer ${__SLATE_LIVE_TOKEN__}`,'content-type':'application/json'},body:JSON.stringify({runId:created.value.id,model:'gpt-6-astra',providerReceipt:view.output.providerReceipt,tokens:view.cost,costUnit:view.costUnit,monetaryCost:null,answer:view.output.answer})});expect(proof.status).toBe(200);
 await env.DB.prepare('UPDATE page_grants SET revoked_at=? WHERE id=?').bind(new Date().toISOString(),f.readerGrant).run();const deniedCookie=await sessionFor(f.reader);
 expect((await api.request(`http://localhost:8787/api/runs/${created.value.id}`,{headers:{cookie:deniedCookie}},bindings)).status).toBe(404);
});
