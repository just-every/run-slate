{
  "contractVersion": 1,
  "cliVersion": "0.2.80",
  "profile": "first-party",
  "defaults": {
    "serverLimit": 10,
    "idleSeconds": 43200
  },
  "pins": {
    "node": "22.20.0",
    "pnpm": "10.12.4"
  },
  "verbs": {
    "install": {
      "flags": [
        "--help",
        "--cwd",
        "--non-interactive",
        "--json",
        "--no-queue"
      ],
      "effects": "Frozen dependency installation only; no setup or remote effect."
    },
    "setup": {
      "flags": [
        "--help",
        "--cwd",
        "--non-interactive",
        "--json",
        "--owner-email",
        "--owner-name",
        "--port",
        "--host",
        "--answers",
        "--door",
        "--no-queue"
      ],
      "effects": "Builds Slate, applies local migrations, preserves private native settings and prepares native owner sign-in; stops the temporary app. No provider calls."
    },
    "dev": {
      "flags": [
        "--help",
        "--cwd",
        "--non-interactive",
        "--json",
        "--port",
        "--host",
        "--idle-timeout",
        "--stop",
        "--detach",
        "--foreground",
        "--as",
        "--login",
        "--models",
        "--models-service",
        "--door",
        "--direct",
        "--demo",
        "--platform",
        "--no-queue"
      ],
      "effects": "Starts one health-gated foreground Vite development instance with silently suppressed local mail and retained local data; --stop tears it down."
    },
    "preview": {
      "flags": [
        "--help",
        "--cwd",
        "--non-interactive",
        "--json",
        "--port",
        "--host",
        "--idle-timeout",
        "--stop",
        "--detach",
        "--foreground",
        "--platform",
        "--no-queue"
      ],
      "effects": "Builds changed production output and serves a fixed foreground Worker with silently suppressed local mail and retained local data; --stop tears it down."
    },
    "build": {
      "flags": [
        "--help",
        "--cwd",
        "--non-interactive",
        "--json",
        "--site",
        "--platform",
        "--no-queue"
      ],
      "effects": "Builds production Worker/assets with private settings isolated and restored exactly; records native source/output identity."
    },
    "verify": {
      "flags": [
        "--help",
        "--cwd",
        "--non-interactive",
        "--json",
        "--no-queue"
      ],
      "effects": "Runs the complete internal verification target; no deployment."
    },
    "reset": {
      "flags": [
        "--help",
        "--cwd",
        "--non-interactive",
        "--json",
        "--yes"
      ],
      "effects": "After explicit confirmation removes only declared local state, settings and installer drafts; retains source, exports and deployment receipts."
    },
    "deploy": {
      "flags": [
        "--help",
        "--cwd",
        "--non-interactive",
        "--json",
        "--owner-name",
        "--environment",
        "--dry-run",
        "--site",
        "--demo",
        "--host",
        "--env-file",
        "--image",
        "--bind-address",
        "--http-port",
        "--https-port",
        "--remove",
        "--yes",
        "--set-secret",
        "--unset-secret",
        "--rotate-secret",
        "--reopen-installation-key",
        "--platform",
        "--no-queue"
      ],
      "effects": "Uses Base deploy-kit in the owner Cloudflare account, with health checking; --dry-run builds and validates locally with no provider requests."
    },
    "export": {
      "flags": [
        "--help",
        "--cwd",
        "--non-interactive",
        "--json",
        "--target",
        "--output",
        "--origin",
        "--session-file",
        "--platform",
        "--no-queue"
      ],
      "effects": "Writes a new owner-only complete local D1/R2 installation archive through Base portability, or exports an authenticated hosted installation with --target remote --origin and --session-file; requires current native owner coverage and fresh email proof. Excludes credentials, sessions and transient caches. Base deployment controller ledger remains a native inventory integration blocker."
    },
    "import": {
      "flags": [
        "--help",
        "--cwd",
        "--non-interactive",
        "--json",
        "--target",
        "--input",
        "--journal",
        "--origin",
        "--session-file",
        "--yes",
        "--legacy-v1",
        "--acknowledge-unverified-metadata",
        "--output",
        "--platform",
        "--no-queue"
      ],
      "effects": "Validates and restores into an empty local installation after explicit confirmation; identities require fresh native sign-in and effect authority must be renewed. Remote transfer is unsupported."
    },
    "doctor": {
      "flags": [
        "--help",
        "--cwd",
        "--non-interactive",
        "--json"
      ],
      "effects": "Read-only tool/configuration/state diagnostics; no provider requests."
    },
    "describe": {
      "flags": [
        "--help",
        "--cwd",
        "--non-interactive",
        "--json"
      ],
      "effects": "Read-only command, flags, aliases, effects and state description."
    },
    "check": {
      "flags": [
        "--help",
        "--cwd",
        "--non-interactive",
        "--json",
        "--profile"
      ],
      "effects": "Read-only structural first-party contract validation before dependencies or configuration exist."
    },
    "release": {
      "flags": [
        "--repo",
        "--project",
        "--repository",
        "--output",
        "--ref",
        "--public-base",
        "--dry-run",
        "--local-verify",
        "--verify-workflow",
        "--scan-timeout-seconds",
        "--tag",
        "--clean-history",
        "--onto",
        "--env-file",
        "--allow-placeholder-mark",
        "--no-queue"
      ],
      "effects": "Runs Base release validation, scans and local clean-history export; never pushes or deploys."
    },
    "demo": {
      "flags": [
        "--help",
        "--cwd",
        "--non-interactive",
        "--json",
        "--port",
        "--host",
        "--idle-timeout",
        "--stop",
        "--detach",
        "--foreground",
        "--no-queue"
      ],
      "effects": "A throwaway demo of this seed (rer dev --demo): fresh data in .rer/demo/START (deleted when it stops: --stop, Ctrl-C or its end, one hour by default or --idle-timeout), the saved owner signed in, the seed's demo data, Demo in the app name and title, real public reads/checks and simulated external writes (RER_DEMO=1; the checkout's own data is never touched)."
    },
    "adopt-edition": {
      "bootstrap": "before",
      "flags": [
        "--help",
        "--cwd",
        "--non-interactive",
        "--json"
      ],
      "effects": "Add edition.json and sources.lock.json for the existing tracked local source, preserving declared project identity and existing copy/composition records. Create an empty base-copies.json only when none exists. Review and stage the new authoring inputs; no source regeneration, install setup or commit."
    },
    "refresh-base": {
      "bootstrap": "before",
      "flags": [
        "--help",
        "--cwd",
        "--non-interactive",
        "--json",
        "--ref",
        "--base",
        "--record",
        "--offline"
      ],
      "effects": "Refresh recorded Base copies to --ref FULL_COMMIT, preserving acknowledged adaptations and applied migrations; announce removed singleton retirement. Acquire committed source from the declared Base repository (default https://github.com/runeditrun/base.git), or use --base CHECKOUT. --offline requires --base and never acquires remote source. Refuse incomplete Git checkouts without changing their records. Review the diff and run edition tests before committing."
    },
    "signin": {
      "flags": [
        "--help",
        "--cwd",
        "--non-interactive",
        "--json",
        "--environment",
        "--env-file"
      ],
      "effects": "A one-time sign-in link for the hosted owner, without mail. Uses the Cloudflare credentials that deployed --environment (default production; from the environment or --env-file) to write a single-use grant for the recorded owner into that deployment's auth database, then prints the link once to this terminal; it is never saved. The link works once, only for that owner, expires within 15 minutes, and its use is recorded in the owner's audit log. Signed in this way, the owner can correct a wrong email in settings."
    }
  },
  "aliases": {
    "setup": "setup",
    "dev": "dev",
    "preview": "preview",
    "build": "build",
    "verify": "verify",
    "reset": "reset",
    "deploy": "deploy",
    "export": "export",
    "import": "import",
    "doctor": "doctor",
    "describe": "describe",
    "check": "check",
    "release": "release",
    "deps": "install",
    "rer": null
  },
  "local": {
    "state": ".wrangler/state",
    "settings": [
      ".dev.vars",
      ".dev.vars.previous"
    ],
    "installerState": ".seed/installer",
    "prepared": false,
    "ownerSaved": false,
    "origin": null,
    "devIdentity": true,
    "devKey": ".rer/local/dev-key.env"
  },
  "door": {
    "protocol": 1
  },
  "repositoryCommands": {
    "install": {
      "usage": "rer install <repo> [--dir DIR] [FLAGS]",
      "effects": "Install rer for this user, clone or reuse the repository, install its dependencies, then stop."
    },
    "setup": {
      "usage": "rer setup <repo> [--dir DIR] [FLAGS]",
      "effects": "Install rer, clone or reuse the repository, install dependencies and set up a local owner, then print the dev command."
    },
    "dev": {
      "usage": "rer dev <repo> [--dir DIR] [FLAGS]",
      "effects": "Install rer, clone or reuse the repository, install and set up as needed, then start dev and print RER_READY and RER_OPEN."
    }
  }
}
