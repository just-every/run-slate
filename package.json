{
  "name": "slate",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@8.15.6",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "setup": "node scripts/setup.mjs",
    "deploy": "node scripts/deploy.mjs",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm build && node scripts/verify.mjs && pnpm test:foundation && pnpm test:platform && pnpm test:profile",
    "test:workers": "vitest run",
    "test:foundation": "tsx --test --test-concurrency=1 tests/e2e/auth-paths.test.js tests/e2e/runtime-config.test.js tests/e2e/foundation-runtime.test.mjs",
    "test:platform": "tsx --test tests/e2e/platform-adapters.test.ts tests/e2e/deployment-config.test.mjs tests/e2e/knowledge-model.test.mjs tests/e2e/search/search-location.test.ts tests/e2e/deployment-prefix.test.mjs",
    "test:browser": "node --test --test-concurrency=1 tests/e2e/browser-runtime.test.mjs",
    "test:artifact": "node --test tests/e2e/production-artifact.test.mjs",
    "test:imports": "vitest run tests/e2e/imports",
    "test:ui": "tsx --test tests/e2e/editor/rich-text-editing.test.tsx tests/e2e/editor/editable-composition.test.mjs tests/e2e/page-move-state.test.tsx",
    "test:ui:capture": "node tests/ui/capture.mjs",
    "test:frontend": "tsx --test tests/flagship/frontend/*.test.ts",
    "export": "node src/core/features/portability/command.mjs backup",
    "import": "node src/core/features/portability/command.mjs restore",
    "test:profile": "tsx --test tests/profile/*.node.tsx tests/profile/*.node.mjs && vitest run --config tests/profile/vitest.config.ts",
    "publish-check": "pnpm verify && pnpm test:release-source && pnpm source:check && node scripts/operations.mjs describe && node scripts/publish-check.mjs",
    "source:check": "node scripts/edition-authoring/cli.mjs check && node scripts/sync-integration.mjs --check",
    "source:lock": "node scripts/edition-authoring/cli.mjs lock",
    "integration:sync": "node scripts/sync-integration.mjs --write",
    "artifact:delivery": "node scripts/build-delivery-artifact.mjs",
    "test:release-source": "node --test tests/release/*.test.mjs",
    "check:rer-adoption": "tsx scripts/check-rer-adoption.mjs",
    "check:deployment": "node scripts/operations.mjs check",
    "test:delivery-artifact": "pnpm artifact:delivery && node tests/release/delivery-runtime.mjs",
    "test:release-regressions": "vitest run --config tests/qualification/publication-relocation/vitest.config.ts && vitest run --config tests/qualification/erasure-metadata/vitest.config.ts && node --test tests/qualification/release-shell/console-regression.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260908.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.129.1"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toggle": "1.1.18",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-router": "1.170.33",
    "@tanstack/react-start": "1.168.50",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "fast-xml-parser": "5.11.1",
    "fflate": "0.8.3",
    "hono": "4.13.7",
    "lucide-react": "1.38.0",
    "parse5": "8.0.1",
    "pdf-lib": "1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.1.5"
  },
  "pnpm": {
    "comment": "@cloudflare/vitest-pool-workers 0.22.0 pins miniflare 5.20260815.0-alpha, whose workerd supports compatibility dates only up to 2026-08-22 and so refuses this seed's 2026-09-08. The override lifts the pool onto the same miniflare wrangler 4.129.1 depends on, so tests, `wrangler dev`, and production run one workerd.",
    "overrides": {
      "miniflare": "5.20260907.0-alpha"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/just-every/slate.git"
  }
}
