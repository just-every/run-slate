{
  "name": "slate",
  "private": true,
  "license": "MIT",
  "version": "0.4.0",
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "dev": "rer dev",
    "setup": "rer setup",
    "deploy": "rer deploy",
    "build": "rer build",
    "preview": "rer preview",
    "typecheck": "tsc --noEmit",
    "verify": "rer verify",
    "test:workers": "vitest run",
    "test:foundation": "tsx --test --test-concurrency=1 tests/e2e/auth-paths.test.js tests/e2e/runtime-config.test.js tests/e2e/foundation-runtime.test.mjs",
    "test:platform": "tsx --test tests/e2e/landing-styles.test.mjs tests/e2e/platform-adapters.test.ts tests/e2e/knowledge-model.test.mjs tests/e2e/search/search-location.test.ts",
    "test:artifact": "node --test tests/e2e/production-artifact.test.mjs",
    "test:docs": "node --test tests/docs/docs-site.test.mjs tests/docs/docs-dev-sync.test.mjs",
    "test:imports": "vitest run tests/e2e/imports",
    "test:ui": "tsx --test tests/e2e/editor/rich-text-editing.test.tsx tests/e2e/editor/editable-composition.test.mjs tests/e2e/page-move-state.test.tsx",
    "test:ui:capture": "node tests/ui/capture.mjs",
    "export": "rer export",
    "import": "rer import",
    "test:profile": "tsx --test tests/profile/*.node.tsx tests/profile/*.node.mjs && vitest run --config tests/profile/vitest.config.ts",
    "publish-check": "rer verify && rer describe && node scripts/publish-check.mjs",
    "source:check": "node scripts/edition-authoring/cli.mjs check && node scripts/sync-integration.mjs --check",
    "source:lock": "node scripts/edition-authoring/cli.mjs lock",
    "integration:sync": "node scripts/sync-integration.mjs --write",
    "artifact:delivery": "node scripts/build-delivery-artifact.mjs",
    "test:release-source": "node --test tests/release/*.test.mjs",
    "check:rer-adoption": "tsx scripts/check-rer-adoption.mjs",
    "test:delivery-artifact": "pnpm artifact:delivery && node tests/release/delivery-runtime.mjs",
    "test:release-regressions": "vitest run --config tests/qualification/publication-relocation/vitest.config.ts && vitest run --config tests/qualification/erasure-metadata/vitest.config.ts && node --test tests/qualification/release-shell/console-regression.test.mjs",
    "test:ui:reachability": "node --test tests/qualification/ui-convergence/reachability.test.mjs",
    "test:ui:journeys": "node --test --test-concurrency=1 tests/qualification/ui-convergence/journeys.test.mjs",
    "test:ui:polish": "node --test --test-concurrency=1 tests/ui/polish-journeys.test.mjs",
    "test:qualification": "node tests/qualification/run.mjs",
    "test:ui:state": "tsx --test tests/qualification/ui-convergence/ask-draft.test.ts tests/qualification/ui-convergence/access-expiry.test.ts",
    "cf-typegen": "node scripts/cf-typegen.mjs",
    "cf-typegen:check": "node scripts/cf-typegen.mjs --check",
    "verify-base": "node scripts/base-proof/verify.mjs",
    "test:installer": "node --test --test-concurrency=2 tests/installer/*.test.mjs",
    "test:typegen": "node --test --test-concurrency=2 tests/typegen*.test.mjs",
    "test:portability": "node --test --test-concurrency=2 tests/portability/*.test.mjs",
    "check:operation-commands": "node scripts/check-operation-commands.mjs",
    "test:local-journey": "node --test --test-concurrency=1 tests/local-journey/*.test.mjs",
    "test:local-outbox": "tsx --test tests/e2e/local-outbox.node.test.mts",
    "test:base-proof": "node --test --test-concurrency=1 tests/base-proof/*.test.mjs",
    "test:rer-editor": "node --test --test-concurrency=1 tests/rer/editor.test.mjs",
    "verify:app": "rer check --profile first-party && pnpm cf-typegen:check && pnpm verify-base && pnpm typecheck && pnpm check:contract && pnpm check:operation-commands && pnpm build && pnpm source:check && pnpm check:artifact",
    "reset": "rer reset",
    "release": "rer release",
    "doctor": "rer doctor",
    "describe": "rer describe",
    "check": "rer check",
    "deps": "rer install",
    "rer": "rer",
    "check:contract": "node scripts/check-contract.mjs",
    "check:artifact": "node scripts/check-artifact.mjs",
    "verify:ci": "pnpm verify && pnpm test:base-proof && pnpm test:docs && pnpm test:ui:polish && node scripts/verify.mjs && pnpm test:foundation && pnpm test:platform && pnpm test:profile && pnpm test:installer && pnpm test:typegen && pnpm test:portability && pnpm test:local-journey && pnpm test:local-outbox && pnpm test:release-source && pnpm test:delivery-artifact && pnpm test:rer-editor"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260908.1",
    "@playwright/test": "1.63.0",
    "@runeditrun/rer": "0.2.80",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "highlight.js": "10.7.3",
    "react-markdown": "6.0.3",
    "remark-gfm": "1.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.129.1"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toggle": "1.1.18",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@xmldom/xmldom": "0.9.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "fast-xml-parser": "5.11.1",
    "fflate": "0.8.3",
    "hono": "4.13.7",
    "lucide-react": "1.38.0",
    "parse5": "8.0.1",
    "pdf-lib": "1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "xml-crypto": "6.4.0",
    "zod": "4.1.5"
  },
  "pnpm": {
    "comment": "@cloudflare/vitest-pool-workers 0.22.0 pins miniflare 5.20260815.0-alpha, whose workerd supports compatibility dates only up to 2026-08-22 and so refuses this seed's 2026-09-08. The override lifts the pool onto the same miniflare wrangler 4.129.1 depends on, so tests, `wrangler dev`, and production run one workerd. Reviewed security overrides pin sharp 0.35.5 and only this miniflare version's undici 7.29.1; direct dependency pins remain unchanged.",
    "overrides": {
      "miniflare": "5.20260907.0-alpha",
      "sharp": "0.35.5",
      "miniflare@5.20260907.0-alpha>undici": "7.29.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/just-every/run-slate.git"
  }
}
