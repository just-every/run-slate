{
  "schema": 1,
  "title": "Slate setup",
  "groups": [
    {
      "id": "owner",
      "label": "Native owner account"
    },
    {
      "id": "email",
      "label": "Sign-in email",
      "help": "Managed mail is included by RER. Free and Assisted hosting use your Resend or SendGrid account; local development suppresses mail and uses the private owner entry."
    },
    {
      "id": "session",
      "label": "Native session"
    },
    {
      "id": "technical",
      "label": "Technical configuration",
      "help": "Implementation settings fixed by the deployment. Product policies are managed inside Slate."
    }
  ],
  "fields": [
    {
      "name": "SETUP_OWNER_EMAIL",
      "label": "Owner email",
      "kind": "email",
      "required": true,
      "group": "owner",
      "runtimeEditable": false,
      "prefill": "account-email"
    },
    {
      "name": "MAIL_PROVIDER",
      "label": "Email provider",
      "help": "Managed hosting configures mail automatically. Free and Assisted hosting need a real delivery provider. Local development suppresses mail.",
      "kind": "select",
      "required": true,
      "default": "resend",
      "options": [
        {
          "value": "development",
          "label": "Local development (mail suppressed)"
        },
        {
          "value": "rer",
          "label": "RER managed mail"
        },
        {
          "value": "resend",
          "label": "Resend"
        },
        {
          "value": "sendgrid",
          "label": "SendGrid"
        }
      ],
      "group": "email",
      "runtimeEditable": false
    },
    {
      "name": "MAIL_FROM",
      "label": "Sender email",
      "kind": "email",
      "default": "auth@localhost.test",
      "required": true,
      "group": "email",
      "runtimeEditable": true
    },
    {
      "name": "MAIL_RELAY_URL",
      "label": "Managed mail relay URL",
      "kind": "url",
      "required": true,
      "when": {
        "field": "MAIL_PROVIDER",
        "equals": "rer"
      },
      "group": "email",
      "runtimeEditable": false
    },
    {
      "name": "MAIL_API_KEY",
      "label": "Mail API key",
      "kind": "secret",
      "input": "entered",
      "required": false,
      "ownerVisible": true,
      "group": "email",
      "presentations": [
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "rer"
          },
          "label": "Managed mail credential",
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "resend"
          },
          "label": "Resend API key",
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "sendgrid"
          },
          "label": "SendGrid API key",
          "required": true
        }
      ]
    },
    {
      "name": "APP_URL",
      "label": "Application origin",
      "kind": "url",
      "runtimeEditable": false
    },
    {
      "name": "PUBLIC_PAGE_HOST",
      "label": "Published-page host",
      "kind": "text",
      "runtimeEditable": false
    },
    {
      "name": "SESSION_SECRET",
      "label": "Session secret",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "generate": "hex",
      "group": "session"
    },
    {
      "name": "SETUP_TOKEN",
      "label": "Owner setup token",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "generate": "hex",
      "group": "session"
    },
    {
      "name": "IDENTITY_PROVIDER",
      "label": "Identity provider",
      "kind": "url",
      "required": false,
      "default": "",
      "help": "Optional shared identity provider. Leave blank for native email links. An existing owner links it with a fresh email proof.",
      "runtimeEditable": false
    },
    {
      "name": "SLATE_PROFILE",
      "label": "Slate profile",
      "kind": "select",
      "default": "core-wiki",
      "options": [
        {
          "value": "core-wiki",
          "label": "Core wiki"
        },
        {
          "value": "flagship",
          "label": "Flagship development"
        }
      ],
      "group": "technical",
      "runtimeEditable": false
    },
    {
      "name": "AI_ENABLED",
      "label": "AI enabled",
      "kind": "select",
      "default": "false",
      "options": [
        {
          "value": "false",
          "label": "Disabled"
        },
        {
          "value": "true",
          "label": "Enabled"
        }
      ],
      "group": "technical",
      "runtimeEditable": false
    },
    {
      "name": "AI_PROVIDER",
      "label": "AI provider",
      "kind": "select",
      "default": "openai",
      "options": [
        {
          "value": "openai",
          "label": "OpenAI"
        },
        {
          "value": "local-codex",
          "label": "Local Codex development"
        }
      ],
      "group": "technical",
      "runtimeEditable": false
    },
    {
      "name": "ALLOW_LOOPBACK_DELEGATION",
      "label": "Allow loopback delegation",
      "kind": "select",
      "default": "false",
      "options": [
        {
          "value": "false",
          "label": "Disabled"
        },
        {
          "value": "true",
          "label": "Enabled"
        }
      ],
      "group": "technical",
      "runtimeEditable": false
    },
    {
      "name": "SSO_ENABLED",
      "label": "SSO enabled",
      "kind": "select",
      "default": "false",
      "options": [
        {
          "value": "false",
          "label": "Disabled"
        },
        {
          "value": "true",
          "label": "Enabled"
        }
      ],
      "group": "technical",
      "runtimeEditable": false
    },
    {
      "name": "LINK_PREVIEWS_ENABLED",
      "label": "Link previews",
      "kind": "select",
      "default": "true",
      "options": [
        {
          "value": "true",
          "label": "Enabled"
        },
        {
          "value": "false",
          "label": "Disabled"
        }
      ],
      "runtimeEditable": true
    }
  ],
  "runtime": {
    "additionalFields": false,
    "exclude": [
      "SETUP_OWNER_EMAIL",
      "MAIL_PROVIDER",
      "MAIL_RELAY_URL",
      "PUBLIC_PAGE_HOST",
      "IDENTITY_PROVIDER",
      "SLATE_PROFILE",
      "AI_ENABLED",
      "AI_PROVIDER",
      "ALLOW_LOOPBACK_DELEGATION",
      "SSO_ENABLED"
    ]
  },
  "steps": [
    {
      "type": "owner-claim",
      "mode": "signed",
      "emailField": "SETUP_OWNER_EMAIL",
      "tokenField": "SETUP_TOKEN",
      "path": "/auth/bootstrap"
    },
    {
      "type": "extension",
      "id": "slate-native-owner"
    },
    {
      "type": "extension",
      "id": "email"
    }
  ],
  "dependencies": [
    {
      "interface": "oidc-provider@1",
      "optional": true,
      "cardinality": 1,
      "address": "IDENTITY_PROVIDER",
      "paths": [
        "/auth/oidc/auth/callback",
        "/auth/oidc/auth/logout"
      ]
    }
  ]
}
